{
  "version": 2,
  "rewrites": [
    { "source": "/", "destination": "/api/index" },
    { "source": "/index.html", "destination": "/api/index" },
    { "source": "/room", "destination": "/api/room" },
    { "source": "/room.html", "destination": "/api/room" },
    { "source": "/jarvis", "destination": "/jarvis.html" },
    { "source": "/portal", "destination": "/api/portal/index" },
    { "source": "/portal.html", "destination": "/api/portal/index" },
    { "source": "/portal/:rest*", "destination": "/api/portal/:rest*" }
  ],
  "functions": {
    "api/jarvis.js": { "includeFiles": "jarvis/**" }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
      ]
    },
    {
      "source": "/room.html",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store" }
      ]
    }
  ]
}
