# Copy to .env.local for local dev. Never commit the real .env.local file.

# Password to enter the data room
DATA_ROOM_PASSWORD=avenue2026

# Random string for signing session cookies (32+ characters)
# Generate one with: openssl rand -base64 48
SESSION_SECRET=replace-this-with-a-long-random-string-please

# Google Drive folder ID where investor uploads land
# Get this from the URL when viewing the folder in Drive
GOOGLE_DRIVE_UPLOAD_FOLDER_ID=

# Google service account JSON key (paste the entire JSON contents on one line)
# See README for setup
GOOGLE_SERVICE_ACCOUNT_KEY=

# Google Drive file IDs for each document (optional - leave blank until you upload)
# Get the ID from the share URL: https://drive.google.com/file/d/THIS_PART/view
DRIVE_FILE_DECK=
DRIVE_FILE_PROMISSORY=
DRIVE_FILE_APPRAISAL=
DRIVE_FILE_CASA=
DRIVE_FILE_APPROVALS=
DRIVE_FILE_BUDGET=
DRIVE_FILE_PLANS=
DRIVE_FILE_RESERVATION=
DRIVE_FILE_TRACK_RECORD=
