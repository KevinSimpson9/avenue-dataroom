# Jarvis Command Center — environment variables
# Copy to .env.local for `vercel dev`, or paste each into Vercel → Settings → Environment Variables.

# Password for the Command Center gate (required).
JARVIS_PASSWORD=change-me

# Long random string used to sign session cookies (required).
# Generate one: openssl rand -base64 48
SESSION_SECRET=change-me-too

# --- One-tap approve write-back (optional) ---------------------------------
# Setting these lets the Approve/Dismiss buttons in the dashboard commit
# status changes to the GitHub repo that holds jarvis/cards/. Without them
# the dashboard is read-only and you approve cards by editing files yourself
# (or by telling Jarvis in chat).
GH_TOKEN=
GH_OWNER=KevinSimpson9
GH_REPO=jarvis-command-center
GH_BRANCH=main
